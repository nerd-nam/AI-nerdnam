# 로컬(Mac) 실제 모드: cp .env.local.example .env 후 uv run --env-file .env uvicorn app.main:app --port 8000
# LLM은 vLLM 대신 로컬 서버(:8001)로. 먼저 원본 모델(evals/local_llm.py), 안 되면 GGUF(llama-server). README "로컬 (real, Mac)"
AI_MODE=real
VLLM_URL=http://localhost:8001
# 응답의 model 값. 로컬 결과가 GPU 서버 결과로 저장되지 않게 실제 모델 이름과 다르게 둔다 (GGUF면 local/Qwen3.5-4B-gguf)
LLM_MODEL=local/Qwen3.5-4B-bf16
# LLM 읽기 제한(초). 로컬은 느리다 (GPU 서버 기본 60)
LLM_TIMEOUT=600
EMBED_DTYPE=float32
